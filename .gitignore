# 公开仓库采用白名单。新增文件须先检查，再显式加入此列表。
/*
!/.gitignore
!/README.md
!/configuration.pending.nix
!/docs/
!/docs/MIGRATION.md
!/home/
!/home/directories.txt
!/home/scripts/
!/home/scripts/*.sh
!/home/config/
!/home/config/.config/
!/home/config/.config/Code/
!/home/config/.config/Code/User/
!/home/config/.config/Code/User/settings.json
!/home/config/.config/fcitx5/
!/home/config/.config/fcitx5/conf/
!/home/config/.config/fcitx5/conf/pinyin.conf
!/home/config/.config/fcitx5/profile
!/home/config/.config/nvim/
!/home/config/.config/nvim/**
!/home/config/.config/btop/
!/home/config/.config/btop/btop.conf
!/home/config/.config/nixpkgs/
!/home/config/.config/nixpkgs/config.nix
!/home/config/.config/user-dirs.dirs
!/assets/
!/assets/grub/
!/assets/grub/elegant-forest-window-left-dark/
!/assets/grub/elegant-forest-window-left-dark/LICENSE
!/assets/grub/elegant-forest-window-left-dark/*.jpg
!/assets/grub/elegant-forest-window-left-dark/*.png
!/assets/grub/elegant-forest-window-left-dark/*.pf2
!/assets/grub/elegant-forest-window-left-dark/*.txt
!/assets/grub/elegant-forest-window-left-dark/icons/
!/assets/grub/elegant-forest-window-left-dark/icons/*.png
!/modules/
!/modules/**/
!/modules/**/*.nix

# 即使日后调整白名单，也不要把凭据或硬件配置提交进来。
**/.env
**/*.key
**/*secret*
**/hardware-configuration.nix
